NEXT_PUBLIC_SUPABASE_URL=<SUPABASE_URL>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<SUPABASE_PUBLISHABLE_KEY>

DATABASE_PASSWORD=<DATABASE_PASSWORD>

# Connect to Supabase via connection pooling
DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[DATABASE_PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database. Used for migrations
DIRECT_URL="postgresql://postgres.[PROJECT_ID]:[DATABASE_PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# AI API keys
ASK_AI_API_KEY=<ASK_AI_API_KEY>